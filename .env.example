# ===== DATA INTELLIGENCE AGENT - CONFIGURATION =====
# Copy to .env and fill in. .env is git-ignored: never commit your API key.

# YOUR INFO (shown in report signature)
YOUR_NAME=Your name
YOUR_COMPANY=Your company

# DATA (relative paths are resolved from the project folder)
DATA_INPUT_PATH=./data/raw/
DATA_OUTPUT_PATH=./data/cleaned/
REPORTS_PATH=./data/reports/

# SUPPORTED FORMATS
SUPPORT_CSV=true
SUPPORT_EXCEL=true

# REPORTS
GENERATE_HTML_DASHBOARD=true
GENERATE_HTML_REPORT=true

# CLAUDE AI (smart analysis). Without a key, rule-based insights are used.
ANTHROPIC_API_KEY=sk-xxxxx
ANALYST_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (higher = deeper analysis, more tokens)
ANALYST_EFFORT=high
USE_CLAUDE=true

# LOGGING
LOG_LEVEL=INFO
LOG_FILE=./logs/databot.log
SAVE_CLEANING_REPORT=true

# DATA CLEANING
AUTO_FIX_NULLS=true
AUTO_REMOVE_DUPLICATES=true
AUTO_DETECT_OUTLIERS=true
OUTLIER_THRESHOLD=2.5

# PERFORMANCE
MAX_ROWS_PER_FILE=100000
CHUNK_SIZE_PROCESSING=10000
TIMEOUT_SECONDS=300
