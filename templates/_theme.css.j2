:root {
  color-scheme: light;
  --surface-0: #f4f3f0;
  --surface-1: #fcfcfb;
  --surface-2: #f0efec;
  --border: #e2e1dc;
  --text-primary: #0b0b0b;
  --text-secondary: #52514e;
  --text-muted: #77766f;
  --accent: #2a78d6;
  --series-1: #2a78d6;
  --series-1-soft: rgba(42, 120, 214, 0.12);
  --grid: #e8e7e3;
  --good: #0a7d0a;
  --critical: #c03030;
  --warning-bg: #fff4dc;
  --warning-ink: #6b4a00;
  --shadow: 0 1px 2px rgba(0, 0, 0, 0.04), 0 4px 16px rgba(0, 0, 0, 0.04);
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    color-scheme: dark;
    --surface-0: #121211;
    --surface-1: #1a1a19;
    --surface-2: #232321;
    --border: #2f2f2c;
    --text-primary: #f0efec;
    --text-secondary: #c3c2b7;
    --text-muted: #94938a;
    --accent: #3987e5;
    --series-1: #3987e5;
    --series-1-soft: rgba(57, 135, 229, 0.16);
    --grid: #2a2a28;
    --good: #3cc23c;
    --critical: #e66767;
    --warning-bg: #3a2f12;
    --warning-ink: #f5d48a;
    --shadow: none;
  }
}
:root[data-theme="dark"] {
  color-scheme: dark;
  --surface-0: #121211;
  --surface-1: #1a1a19;
  --surface-2: #232321;
  --border: #2f2f2c;
  --text-primary: #f0efec;
  --text-secondary: #c3c2b7;
  --text-muted: #94938a;
  --accent: #3987e5;
  --series-1: #3987e5;
  --series-1-soft: rgba(57, 135, 229, 0.16);
  --grid: #2a2a28;
  --good: #3cc23c;
  --critical: #e66767;
  --warning-bg: #3a2f12;
  --warning-ink: #f5d48a;
  --shadow: none;
}
* { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; }
body {
  margin: 0;
  background: var(--surface-0);
  color: var(--text-primary);
  font: 15px/1.55 "Inter", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  font-variant-numeric: tabular-nums;
}
h1, h2, h3 { line-height: 1.25; margin: 0; }
h1 { font-size: 1.6rem; font-weight: 700; letter-spacing: -0.01em; }
h2 { font-size: 1.1rem; font-weight: 650; }
h3 { font-size: 0.98rem; font-weight: 600; }
p { margin: 0; }
.muted { color: var(--text-muted); }
.secondary { color: var(--text-secondary); }
.wrap { max-width: 1240px; margin: 0 auto; padding: 24px 16px 48px; }
.card {
  background: var(--surface-1);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 18px 20px;
  box-shadow: var(--shadow);
  min-width: 0;
}
.badge {
  display: inline-flex; align-items: center; gap: 6px;
  font-size: 0.78rem; font-weight: 600;
  padding: 3px 10px; border-radius: 999px;
  background: var(--surface-2); color: var(--text-secondary);
  border: 1px solid var(--border);
}
.badge.ai { color: var(--accent); }
.pill { font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; padding: 2px 8px; border-radius: 6px; background: var(--surface-2); color: var(--text-secondary); white-space: nowrap; }
.pill.high { background: var(--series-1-soft); color: var(--accent); }
.kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 12px; }
.kpi .label { font-size: 0.8rem; color: var(--text-secondary); font-weight: 500; }
.kpi .value { font-size: 1.65rem; font-weight: 700; margin-top: 4px; letter-spacing: -0.01em; }
.kpi .sub { font-size: 0.8rem; color: var(--text-muted); margin-top: 2px; }
.delta-up { color: var(--good); font-weight: 600; }
.delta-down { color: var(--critical); font-weight: 600; }
.chart-box { position: relative; height: 280px; margin-top: 12px; }
.table-scroll { overflow-x: auto; margin-top: 12px; }
table { width: 100%; border-collapse: collapse; font-size: 0.86rem; }
th, td { text-align: left; padding: 7px 10px; border-bottom: 1px solid var(--border); white-space: nowrap; }
th { color: var(--text-secondary); font-weight: 600; background: var(--surface-2); position: sticky; top: 0; }
td.num, th.num { text-align: right; }
tr.flag-inconsistent td { background: var(--warning-bg); color: var(--warning-ink); }
.notice { background: var(--warning-bg); color: var(--warning-ink); border-radius: 10px; padding: 10px 14px; font-size: 0.9rem; }
ul.clean { margin: 8px 0 0; padding-left: 18px; }
ul.clean li { margin: 4px 0; }
.theme-toggle {
  border: 1px solid var(--border); background: var(--surface-1); color: var(--text-secondary);
  border-radius: 8px; padding: 6px 10px; font: inherit; font-size: 0.82rem; cursor: pointer;
}
footer { margin-top: 32px; font-size: 0.82rem; color: var(--text-muted); text-align: center; }
@media (max-width: 640px) {
  .kpi .value { font-size: 1.35rem; }
  .card { padding: 14px; }
}
